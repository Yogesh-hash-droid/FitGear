# FitGear environment variables - copy to .env and fill in real values.
# NEVER commit the real .env file.

# --- Backend security (REQUIRED, min 32 chars) ---
JWT_SECRET=change-me-to-a-random-secret-with-32-plus-chars

# Token lifetime (ISO-8601 duration)
JWT_EXPIRATION=PT12H

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Admin account (seeded on startup; public registration is customer-only) ---
ADMIN_EMAIL=admin@fitgear.local
ADMIN_PASSWORD=ChangeMe-Admin-123!

# --- MySQL (used by the mysql profile / Docker Compose / Render) ---
# Production on Aiven: set sslMode=VERIFY_CA and paste the Aiven CA (PEM) as a
# Render secret file named aiven-ca.pem - the app installs it as the JVM
# truststore at startup (see DEPLOYMENT_GUIDE.md). Example shape only:
# MYSQL_URL=jdbc:mysql://AIVEN-HOST:AIVEN-PORT/defaultdb?sslMode=VERIFY_CA&serverTimezone=UTC
MYSQL_URL=jdbc:mysql://localhost:3306/fitgear?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=root
MYSQL_PASSWORD=ChangeMe-Db-123!

# Optional MySQL connection-pool tuning (defaults: max 10, min idle 2)
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2

# --- Razorpay test mode (leave empty to offer Cash on Delivery only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Frontend (Vite) - API base URL ---
# Local dev: optional (defaults to http://localhost:8080/api)
# Vercel production: REQUIRED - your Render backend URL, e.g.
# VITE_API_BASE_URL=https://YOUR-RENDER-BACKEND-URL.onrender.com/api
VITE_API_BASE_URL=
# Legacy alias, still honoured:
# VITE_API_URL=
